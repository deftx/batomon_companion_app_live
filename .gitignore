run_save.json

# Local secrets / private config — NEVER commit (public repo)
tools/ai-key.txt
tools/discord-webhook.txt
tools/feedback-email.txt

# Internal working docs — kept local / private repo only, not for the public release
tools/berrymint-message.md
tools/brain-research.md
RELEASING.md

